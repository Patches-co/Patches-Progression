{
  "multipart": [
    {
      "when": { "type": "medium", "facing": "north" },
      "apply": { "model": "patches-progression:block/flint_pebble_medium" }
    },
    {
      "when": { "type": "medium", "facing": "east" },
      "apply": { "model": "patches-progression:block/flint_pebble_medium", "y": 90 }
    },
    {
      "when": { "type": "medium", "facing": "south" },
      "apply": { "model": "patches-progression:block/flint_pebble_medium", "y": 180 }
    },
    {
      "when": { "type": "medium", "facing": "west" },
      "apply": { "model": "patches-progression:block/flint_pebble_medium", "y": 270 }
    },
    {
      "when": { "type": "small", "facing": "north" },
      "apply": { "model": "patches-progression:block/flint_pebble_small" }
    },
    {
      "when": { "type": "small", "facing": "east" },
      "apply": { "model": "patches-progression:block/flint_pebble_small", "y": 90 }
    },
    {
      "when": { "type": "small", "facing": "south" },
      "apply": { "model": "patches-progression:block/flint_pebble_small", "y": 180 }
    },
    {
      "when": { "type": "small", "facing": "west" },
      "apply": { "model": "patches-progression:block/flint_pebble_small", "y": 270 }
    }
  ]
}
